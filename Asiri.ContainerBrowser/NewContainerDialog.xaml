<Window x:Class="uk.andyjohnson.Asiri.ContainerBrowser.NewContainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Container"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Container file:" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="PathTextBox" Width="260" IsReadOnly="True"/>
            <Button x:Name="BrowseButton" Content="Browse..." Width="75" Margin="8,0,0,0" Click="BrowseButton_Click"/>
        </StackPanel>

        <TextBlock Text="Size (MB):" Margin="0,12,0,6"/>
        <TextBox x:Name="SizeTextBox" Width="100" HorizontalAlignment="Left"/>

        <TextBlock Text="Filesystem:" Margin="0,12,0,6"/>
        <ComboBox x:Name="FileSystemTypeComboBox" HorizontalAlignment="Left" Width="200" SelectionChanged="FileSystemTypeComboBox_SelectionChanged"/>

        <TextBlock Text="Cluster size in bytes, optional (exFAT only):" Margin="0,12,0,6"/>
        <TextBox x:Name="ClusterSizeTextBox" Width="100" HorizontalAlignment="Left" IsEnabled="False"/>

        <TextBlock Text="Volume label (optional):" Margin="0,12,0,6"/>
        <TextBox x:Name="LabelTextBox" Width="200" HorizontalAlignment="Left"/>

        <CheckBox x:Name="EnableWriteAccessCheckBox" Content="Enable write access" IsChecked="True" Margin="0,16,0,0"/>

        <TextBlock Text="Password:" Margin="0,12,0,6"/>
        <PasswordBox x:Name="PasswordBoxControl"/>

        <TextBlock Text="Encryption algorithm:" Margin="0,12,0,6"/>
        <ComboBox x:Name="AlgorithmComboBox" HorizontalAlignment="Left" Width="200"/>

        <TextBlock Text="Hash algorithm:" Margin="0,12,0,6"/>
        <ComboBox x:Name="HashAlgorithmComboBox" HorizontalAlignment="Left" Width="200"/>

        <TextBlock Text="PIM (optional):" Margin="0,12,0,6"/>
        <TextBox x:Name="PimTextBox" Width="80" HorizontalAlignment="Left"/>

        <TextBlock Text="Keyfiles (optional):" Margin="0,12,0,6"/>
        <ListBox x:Name="KeyFilesListBox" Height="100" SelectionMode="Extended"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Add..." Width="75" Margin="0,0,8,0" Click="AddKeyFileButton_Click"/>
            <Button Content="Remove" Width="75" Click="RemoveKeyFileButton_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="75"/>
        </StackPanel>
    </StackPanel>
</Window>
