<Window x:Class="uk.andyjohnson.Asiri.ContainerBrowser.DumpImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Filesystem Image"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Output file:" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="PathTextBox" Width="260" IsReadOnly="True"/>
            <Button x:Name="BrowseButton" Content="Browse..." Width="75" Margin="8,0,0,0" Click="BrowseButton_Click"/>
        </StackPanel>

        <TextBlock Text="Format:" Margin="0,16,0,6"/>
        <ComboBox x:Name="FormatComboBox" HorizontalAlignment="Left" Width="200"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="75"/>
        </StackPanel>
    </StackPanel>
</Window>
