<Window x:Class="uk.andyjohnson.Asiri.ContainerBrowser.NewPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Container Credentials"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Enter the new password:" Margin="0,0,0,6"/>
        <PasswordBox x:Name="NewPasswordBoxControl"/>

        <TextBlock Text="New PIM (optional):" Margin="0,12,0,6"/>
        <TextBox x:Name="NewPimTextBox" Width="80" HorizontalAlignment="Left"/>

        <TextBlock Text="New keyfiles (optional):" Margin="0,12,0,6"/>
        <ListBox x:Name="NewKeyFilesListBox" Height="100" SelectionMode="Extended"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Add..." Width="75" Margin="0,0,8,0" Click="AddKeyFileButton_Click"/>
            <Button Content="Remove" Width="75" Click="RemoveKeyFileButton_Click"/>
        </StackPanel>

        <CheckBox x:Name="ChangeHashAlgorithmCheckBox" Content="Use a different hash algorithm"
                  Margin="0,16,0,6" Checked="ChangeHashAlgorithmCheckBox_CheckedChanged" Unchecked="ChangeHashAlgorithmCheckBox_CheckedChanged"/>
        <ComboBox x:Name="NewHashAlgorithmComboBox" HorizontalAlignment="Left" Width="200" IsEnabled="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="75"/>
        </StackPanel>
    </StackPanel>
</Window>
